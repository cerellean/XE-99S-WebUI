#!/bin/sh
# ============================================================================
#  XE-99S WebUI 启动脚本
#  用法: S99webui {start|stop|restart|status}
# ============================================================================

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CONF="$ROOT/etc/webui.conf"
PIDFILE="$ROOT/var/httpd.pid"
LOG="$ROOT/var/httpd.log"

conf_get() {
	[ -r "$CONF" ] || { printf '%s' "$2"; return; }
	v=$(awk -v k="$1" '
		/^[[:space:]]*#/ { next }
		{
			i = index($0, "=")
			if (i < 2) next
			key = substr($0, 1, i - 1)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
			if (key != k) next
			val = substr($0, i + 1)
			gsub(/^[[:space:]]+|[[:space:]]+$/, "", val)
			print val; exit
		}' "$CONF")
	printf '%s' "${v:-$2}"
}

find_httpd() {
	_h=$(conf_get HTTPD "")
	if [ -n "$_h" ] && [ -x "$_h" ]; then printf '%s' "$_h"; return 0; fi
	if command -v busybox >/dev/null 2>&1 && busybox httpd --help >/dev/null 2>&1; then
		printf '%s' "busybox httpd"
		return 0
	fi
	for _c in /usr/sbin/httpd /usr/bin/httpd /sbin/httpd /bin/httpd; do
		[ -x "$_c" ] && { printf '%s' "$_c"; return 0; }
	done
	return 1
}

start() {
	mkdir -p "$ROOT/var"
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "WebUI 已在运行 (pid $(cat "$PIDFILE"))"
		return 0
	fi
	HTTPD=$(find_httpd) || { echo "错误: 找不到 httpd (busybox httpd 也未启用)"; return 1; }
	PORT=$(conf_get PORT 8080)
	BIND=$(conf_get BIND "")
	echo "启动 WebUI: $HTTPD  port=$PORT  root=$ROOT/www"

	# busybox httpd: -f 前台(由 -h 指定根目录) -p 端口
	# shellcheck disable=SC2086
	# -c 指定 CGI 解释器配置 (*.cgi:/bin/sh)
	if [ -n "$BIND" ]; then
		$HTTPD -h "$ROOT/www" -c "$ROOT/etc/httpd.conf" -p "$BIND:$PORT" >>"$LOG" 2>&1 &
	else
		$HTTPD -h "$ROOT/www" -c "$ROOT/etc/httpd.conf" -p "$PORT" >>"$LOG" 2>&1 &
	fi
	echo $! >"$PIDFILE"
	sleep 1
	if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		echo "已启动 (pid $(cat "$PIDFILE"))"
		return 0
	fi
	echo "启动失败, 详见 $LOG"
	return 1
}

stop() {
	if [ -f "$PIDFILE" ]; then
		_pid=$(cat "$PIDFILE" 2>/dev/null)
		[ -n "$_pid" ] && kill "$_pid" 2>/dev/null
		rm -f "$PIDFILE"
		echo "已停止"
	else
		# 兜底: 按命令行匹配
		_pid=$(ps 2>/dev/null | grep "[h]ttpd -h $ROOT/www" | awk '{ print $1 }')
		[ -n "$_pid" ] && kill "$_pid" 2>/dev/null && echo "已停止 (pid $_pid)"
	fi
	return 0
}

status() {
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
		echo "运行中 (pid $(cat "$PIDFILE"), port $(conf_get PORT 8080))"
		return 0
	fi
	echo "未运行"
	return 1
}

case $1 in
start) start ;;
stop) stop ;;
restart) stop; sleep 1; start ;;
status) status ;;
*) echo "用法: $0 {start|stop|restart|status}" ;;
esac
